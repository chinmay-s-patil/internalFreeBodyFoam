FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          400;
        startFace       107128;
    }
    outlet
    {
        type            patch;
        nFaces          400;
        startFace       107528;
    }
    farField
    {
        type            patch;
        nFaces          3200;
        startFace       107928;
    }
    sphere
    {
        type            wall;
        inGroups        1(wall);
        nFaces          4280;
        startFace       111128;
    }
    masterAMI
    {
        type            cyclicAMI;
        inGroups        1(cyclicAMI);
        nFaces          768;
        startFace       115408;
        matchTolerance  0.001;
        transform       noOrdering;
        neighbourPatch  slaveAMI;
        AMIMethod       faceAreaWeightAMI;
        restartUncoveredSourceFace 1;
    }
    slaveAMI
    {
        type            cyclicAMI;
        inGroups        1(cyclicAMI);
        nFaces          48;
        startFace       116176;
        matchTolerance  0.001;
        transform       noOrdering;
        neighbourPatch  masterAMI;
        AMIMethod       faceAreaWeightAMI;
        restartUncoveredSourceFace 1;
    }
)

