FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     freeBody6DoFPimpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1.0;

deltaT          0.0002;

writeControl    adjustableRunTime;
writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.8;
maxDeltaT       0.0005;

libs
(
    "libfreeBodyRotationalMotion.so"
    "libfallingInletVelocity.so"
);

