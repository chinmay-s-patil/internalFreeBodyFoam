FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;
writeCyclicMatch true;

patches
(
    {
        name            masterAMI;
        patchInfo
        {
            type            cyclicAMI;
            matchTolerance  0.001;
            transform       noOrdering;
            neighbourPatch  slaveAMI;
            method          faceAreaWeightAMI;
        }
        constructFrom patches;
        patches (master);
    }

    {
        name            slaveAMI;
        patchInfo
        {
            type            cyclicAMI;
            matchTolerance  0.001;
            transform       noOrdering;
            neighbourPatch  masterAMI;
            method          faceAreaWeightAMI;
        }
        constructFrom patches;
        patches (slave);
    }
);

