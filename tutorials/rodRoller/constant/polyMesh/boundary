FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

8
(
    rod
    {
        type            wall;
        inGroups        1(wall);
        nFaces          128;
        startFace       9984;
    }
    innerAMI
    {
        type            cyclicAMI;
        inGroups        1(cyclicAMI);
        nFaces          128;
        startFace       10112;
        matchTolerance  0.001;
        transform       noOrdering;
        neighbourPatch  outerAMI;
        AMIMethod       faceAreaWeightAMI;
        restartUncoveredSourceFace 1;
    }
    outerAMI
    {
        type            cyclicAMI;
        inGroups        1(cyclicAMI);
        nFaces          128;
        startFace       10240;
        matchTolerance  0.001;
        transform       noOrdering;
        neighbourPatch  innerAMI;
        AMIMethod       faceAreaWeightAMI;
        restartUncoveredSourceFace 1;
    }
    inlet
    {
        type            patch;
        nFaces          32;
        startFace       10368;
    }
    outlet
    {
        type            patch;
        nFaces          32;
        startFace       10400;
    }
    sides
    {
        type            patch;
        nFaces          64;
        startFace       10432;
    }
    front
    {
        type            empty;
        inGroups        1(empty);
        nFaces          5120;
        startFace       10496;
    }
    back
    {
        type            empty;
        inGroups        1(empty);
        nFaces          5120;
        startFace       15616;
    }
)

