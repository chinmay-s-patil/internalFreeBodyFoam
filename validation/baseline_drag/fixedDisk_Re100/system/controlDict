FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     freeBody6DoFPimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.25;

deltaT          2e-05;

adjustTimeStep  yes;

maxCo           1.5;

maxDeltaT       0.0001;

writeControl    adjustableRunTime;

writeInterval   0.005;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

runTimeModifiable true;

functions
{
    diskForces
    {
        type            forces;
        libs            ( forces );
        patches         ( disk );
        rho             rhoInf;
        rhoInf          1.2;
        CofR            ( 0 0 0 );
        pName           p;
        UName           U;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }
    amiFluxMaster
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            masterAMI;
        operation       sum;
        fields          ( phi );
        writeFields     no;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }
}

libs            ( "libfreeBodyRotationalMotion.so" "libfreeFallingModels.so" "libfallingInletVelocity.so" "libturbulenceModels.so" );


