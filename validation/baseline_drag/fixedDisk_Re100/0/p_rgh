FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    disk
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            totalPressure;
        p0              uniform 0;
        value           $internalField;
    }

    atmosphere
    {
        type            totalPressure;
        p0              uniform 0;
        value           $internalField;
    }

    masterAMI
    {
        type            cyclicAMI;
        value           $internalField;
    }

    slaveAMI
    {
        type            cyclicAMI;
        value           $internalField;
    }
}

