FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     freeBody6DoFPimpleFoam;

startFrom       startTime;

startTime       0.3;

stopAt          endTime;

endTime         0.44;

deltaT          2e-05;

adjustTimeStep  yes;

maxCo           1.5;

maxDeltaT       0.0001;

writeControl    adjustableRunTime;

writeInterval   0.005;

purgeWrite      2;

writeFormat     ascii;

writePrecision  10;

runTimeModifiable true;

libs            ( "libfreeBodyRotationalMotion.so" "libfreeFallingModels.so" "libfallingInletVelocity.so" "libturbulenceModels.so" );


