FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     freeBody6DoFPimpleFoam;

startFrom       startTime;
startTime       3;
stopAt          endTime;
endTime         4.5;

deltaT          0.001;
adjustTimeStep  yes;
maxCo           0.8;
maxDeltaT       0.005;

writeControl    adjustableRunTime;
writeInterval   0.5;
purgeWrite      3;

writeFormat     ascii;
writePrecision  10;
runTimeModifiable true;

libs
(
    "libfreeBodyRotationalMotion.so"
    "libfreeFallingModels.so"
    "libfallingInletVelocity.so"
    "libturbulenceModels.so"
);

