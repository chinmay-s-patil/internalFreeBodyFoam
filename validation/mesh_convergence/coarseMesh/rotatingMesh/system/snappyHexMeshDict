FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    "rotatingGeometry.stl"
    {
        type triSurfaceMesh;
        name rotatingGeometry;
        regions
        {
            master
            {
                name master;
            }
            disk
            {
                name disk;
            }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells 2000000;
    maxGlobalCells 5000000;
    minRefinementCells 10;
    nCellsBetweenLevels 2;
    maxLoadUnbalance 0.10;

    features
    (
        {
            file "rotatingGeometry.eMesh";
            level 2;
        }
    );

    refinementSurfaces
    {
        rotatingGeometry
        {
            level (0 0);
            regions
            {
                master
                {
                    level (0 0);
                    patchInfo
                    {
                        type patch;
                    }
                }
                disk
                {
                    level (2 3);
                    patchInfo
                    {
                        type wall;
                    }
                }
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        rotatingGeometry
        {
            mode inside;
            levels ((1.0 1));
        }
    }

    locationInMesh (0.0005 0.0005 0.0005);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-19;
    minTetQuality -1;
    minArea -1;
    minTwist 0.01;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;

