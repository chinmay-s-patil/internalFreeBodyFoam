FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0.908632 0);

boundaryField
{
    sphere
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    inlet
    {
        type            fallingInletVelocity;
        value           uniform (0 0.908632 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }

    farField
    {
        type            slip;
    }

    masterAMI
    {
        type            cyclicAMI;
        value           $internalField;
    }

    slaveAMI
    {
        type            cyclicAMI;
        value           $internalField;
    }
}

