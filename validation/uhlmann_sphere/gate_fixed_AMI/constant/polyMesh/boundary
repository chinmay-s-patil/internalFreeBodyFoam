6
(
    inlet
    {
        type            patch;
        nFaces          1024;
        startFace       909548;
    }
    outlet
    {
        type            patch;
        nFaces          1024;
        startFace       910572;
    }
    farField
    {
        type            patch;
        nFaces          7680;
