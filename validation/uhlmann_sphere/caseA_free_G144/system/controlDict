FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     freeBody6DoFPimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         35;

deltaT          0.005;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      2;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.8;

maxDeltaT       0.02;

libs            ( "libfreeBodyRotationalMotion.so" "libfallingInletVelocity.so" );

functions
{
    sphereForces
    {
        type            forces;
        libs            ( forces );
        patches         ( sphere );
        rho             rhoInf;
        rhoInf          1;
        CofR            ( 0 0 0 );
        pName           p;
        UName           U;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   1;
    }
}


