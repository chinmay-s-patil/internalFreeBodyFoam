FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fallingFrameDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

u0                  ( 0 -0.908632 0 );
acceleration        ( 0 0 0 );
initialAcceleration ( 0 0 0 );

patches             ( sphere );

mass                0.785398;
freedom             ( 0 0 0 );

rhoInf              1.0;
densityModel        rhoInf;
gravityModel        constant;
groundInterrupt     off;

includeBuoyancy     true;
addedMass           ( 0.2618 0.2618 0.2618 );

rotor
{
    hubOrigin         (0 0 0);
    inertiaPrincipal  (0.0785398 0.0785398 0.0785398);
    rotationFreedom   (0 0 0);
    initialOmega      (0 0 0);
    initialAxis       (0 1 0);
    initialAngleDeg   0.0;
    damping           (0 0 0);
    report            false;
}

print
{
    frameVel        on;
    frameAcc        on;
    altitude        off;
    pressureForce   off;
    viscousForce    off;
    aeroForce       on;
    gravityForce    on;
    netForce        on;
    meanFlow        off;
    relativeVel     off;
    dynamicPressure off;
}

