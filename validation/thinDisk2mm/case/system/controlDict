FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     freeBody6DoFPimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         0.5;

deltaT          2e-5;
adjustTimeStep  yes;
maxCo           1.5;
maxDeltaT       1e-4;

writeControl    adjustableRunTime;
writeInterval   0.005;
purgeWrite      0;

writeFormat     ascii;
writePrecision  10;
runTimeModifiable true;

libs
(
    "libfreeBodyRotationalMotion.so"
    "libfreeFallingModels.so"
    "libfallingInletVelocity.so"
    "libturbulenceModels.so"
);

